# ─────────────────────────────────────────────────────────────────────────────
# FineTuneForge — variables d'environnement (copier vers .env.local)
# Toutes les variables sont validées au démarrage par src/server/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'app (utilisée pour l'auth, les URLs signées, les callbacks)
APP_URL=http://localhost:3000

# Postgres (docker compose: `pnpm db:up`)
DATABASE_URL=postgres://ftf:ftf@localhost:5432/finetuneforge

# Better Auth — secret de signature des sessions (>= 32 caractères)
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Clé de chiffrement des secrets utilisateurs (tokens Hugging Face…) — AES-256-GCM
# 32 octets encodés en base64. Générer : openssl rand -base64 32
ENCRYPTION_KEY=

# OAuth (optionnel — les boutons n'apparaissent que si les deux valeurs sont définies)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hugging Face Hub (à changer uniquement pour un miroir)
HF_ENDPOINT=https://huggingface.co

# Namespace Hugging Face géré par la plateforme (optionnel) : permet de publier
# les modèles sur notre organisation au lieu du compte de l'utilisateur.
HF_PLATFORM_TOKEN=
HF_PLATFORM_ORG=

# ── Fine-tuning ──────────────────────────────────────────────────────────────
# Orchestration : Inngest. En local, lancer `pnpm inngest:dev` et garder INNGEST_DEV=1.
# En production : retirer INNGEST_DEV et renseigner INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Où s'exécute l'entraînement :
#   simulated : progression factice, ni GPU ni Python (développement de l'UI)
#   local     : le trainer Python sur votre machine (services/trainer, `uvicorn trainer.server:app`)
#   modal     : GPU serverless Modal (production)
TRAINING_PROVIDER=simulated
# Requis pour local/modal :
TRAINER_URL=http://localhost:8000
# Générer : openssl rand -hex 32 (une valeur différente pour chaque secret)
TRAINER_API_SECRET=
TRAINER_CALLBACK_SECRET=
# URL publique que le trainer rappelle (par défaut APP_URL). Pour Modal en dev : un tunnel.
TRAINER_CALLBACK_BASE_URL=

# Stockage des fichiers : "local" (disque, dev) ou "s3" (Supabase Storage, R2, S3, MinIO…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage

# Requis si STORAGE_DRIVER=s3
# Supabase Storage : S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# MinIO local      : S3_ENDPOINT=http://localhost:9000 (docker compose --profile s3 up -d)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=finetuneforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
